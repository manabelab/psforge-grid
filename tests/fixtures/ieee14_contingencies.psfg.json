{
  "metadata": {
    "format": "psforge-grid-scenario",
    "version": "1.0"
  },
  "base_case": "ieee14.psfg.json",
  "scenarios": [
    {
      "name": "N-1_Line_1-5",
      "description": "Line 1-5 outage",
      "modifications": [
        {
          "target": "branches",
          "match": {
            "from_bus": 1,
            "to_bus": 5
          },
          "set": {
            "status": 0
          }
        }
      ]
    },
    {
      "name": "N-1_Line_2-3",
      "description": "Line 2-3 outage",
      "modifications": [
        {
          "target": "branches",
          "match": {
            "from_bus": 2,
            "to_bus": 3
          },
          "set": {
            "status": 0
          }
        }
      ]
    },
    {
      "name": "heavy_load_bus14",
      "description": "Double load at bus 14",
      "modifications": [
        {
          "target": "loads",
          "match": {
            "bus_id": 14
          },
          "set": {
            "p_load": 29.5,
            "q_load": 10.0
          }
        }
      ]
    }
  ]
}
